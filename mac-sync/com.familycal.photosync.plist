<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Family Calendar photo sync — launchd job (runs on your Mac).
  Only ONE thing to edit: the sync-photos.sh path in ProgramArguments below.
  Install (modern macOS):
    cp com.familycal.photosync.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.familycal.photosync.plist
  Remove it later with:
    launchctl bootout gui/$(id -u)/com.familycal.photosync
  Runs at login and every hour. Log: /tmp/familycal-photosync.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.familycal.photosync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/REPLACE/WITH/FULL/PATH/TO/family-calendar/mac-sync/sync-photos.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>3600</integer>

  <key>StandardOutPath</key>
  <string>/tmp/familycal-photosync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/familycal-photosync.log</string>
</dict>
</plist>
