# Copy to .env and fill in. Get these from Google Cloud Console (see README).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Where this app runs. On the Pi itself this is fine as-is.
# Must EXACTLY match an "Authorized redirect URI" in your Google OAuth client.
REDIRECT_URI=http://localhost:3000/api/auth/callback

# Which calendar to sync. "primary" = the account's main calendar.
# For a shared family calendar, paste its Calendar ID (Google Calendar >
# Settings > the calendar > "Integrate calendar" > Calendar ID).
CALENDAR_ID=primary

# Server port
PORT=3000

# Minutes of no touch before the photo screensaver kicks in
IDLE_MINUTES=3

# Seconds each screensaver photo is shown before advancing
PHOTO_SECONDS=8

# Weather header (optional). Uses Open-Meteo — free, no API key.
# Find your coordinates at https://www.latlong.net/
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060
TEMP_UNIT=fahrenheit

# Shopping / Costco lists. Choose how they're sourced:
#   LIST_MODE=bridge  -> an always-on iPad running a Shortcuts loop (works with
#                        SHARED Apple Reminders lists; the recommended path)
#   LIST_MODE=caldav  -> direct iCloud CalDAV (only works for NON-shared lists)
#   (unset)           -> auto: caldav if creds below are set, else demo
LIST_MODE=bridge

# Names of the lists to show, comma-separated. In bridge mode these are just the
# expected names until the iPad pushes its data.
REMINDERS_LISTS=Shopping,Costco

# Back the ✅ To-Do tab with a synced Reminders list (must match the iCloud list
# name exactly). Leave blank to use the Pi-stored todo.json instead. It is kept
# out of the Lists chips since it has its own tab.
TODO_LIST=To-Do List

# Optional shared secret: if set, the iPad must send it as the x-bridge-token
# header. Leave blank for an open home network, or set any random string.
BRIDGE_TOKEN=

# Warn on the wall if the iPad's Sync Loop hasn't pushed in this many minutes.
BRIDGE_STALE_MIN=10

# Trash / recycling reminder (optional). Shows a banner the evening before
# collection and the morning of. Day names: Monday..Sunday. Leave blank to disable.
TRASH_DAY=Tuesday
RECYCLING_DAY=Tuesday
# Recycling every OTHER week? Set true and give a date that WAS a recycling week.
RECYCLING_BIWEEKLY=false
RECYCLING_ANCHOR=2026-07-14

# Only needed for LIST_MODE=caldav (non-shared lists). App-specific password from
# https://appleid.apple.com (Sign-In & Security > App-Specific Passwords).
ICLOUD_APPLE_ID=you@icloud.com
ICLOUD_APP_PASSWORD=abcd-efgh-ijkl-mnop

# Screensaver photos from an iCloud Shared Album (optional). Enable "Public
# Website" on the album (Apple Photos on a Mac, or iOS 25 or earlier — iOS 26+
# removed the toggle) and copy the https://www.icloud.com/sharedalbum/#... link.
# IMPORTANT: wrap it in quotes — the link contains a '#', which is otherwise
# treated as the start of a comment. (Or just use the bare token after the #.)
# Photos anyone adds appear automatically; local ./photos files still work too.
ICLOUD_ALBUM="https://www.icloud.com/sharedalbum/#B0Example"

