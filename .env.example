# Copy to .env and fill in. Get these from Google Cloud Console (see README).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Where this app runs. On the Pi itself this is fine as-is.
# Must EXACTLY match an "Authorized redirect URI" in your Google OAuth client.
REDIRECT_URI=http://localhost:3000/api/auth/callback

# Which calendar to sync. "primary" = the account's main calendar.
# For a shared family calendar, paste its Calendar ID (Google Calendar >
# Settings > the calendar > "Integrate calendar" > Calendar ID).
CALENDAR_ID=primary

# Server port
PORT=3000

# Minutes of no touch before the photo screensaver kicks in
IDLE_MINUTES=3

# Weather header (optional). Uses Open-Meteo — free, no API key.
# Find your coordinates at https://www.latlong.net/
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060
TEMP_UNIT=fahrenheit

# Shopping list = a shared Apple Reminders list, via iCloud CalDAV (optional).
# Use the Apple ID that OWNS the list. Create an app-specific password at
# https://appleid.apple.com (Sign-In & Security > App-Specific Passwords).
# List names must match the lists in Reminders exactly (comma-separated).
ICLOUD_APPLE_ID=you@icloud.com
ICLOUD_APP_PASSWORD=abcd-efgh-ijkl-mnop
REMINDERS_LISTS=Shopping,Costco

